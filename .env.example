# Database
DATABASE_URL="postgresql://user:password@localhost:5432/revenant"

# GitHub API (for repo metadata)
GITHUB_TOKEN=""

# API Configuration
API_TIMEOUT_MS=10000
CACHE_TTL_HOURS=24

# Next.js (apps/web)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting
GITHUB_RATE_LIMIT_PER_HOUR=5000
NPM_RATE_LIMIT_PER_SECOND=50

# Feature Flags
ENABLE_CACHING=true
