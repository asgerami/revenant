{
  "name": "revenant-mcp",
  "version": "0.1.0",
  "description": "MCP server for Revenant - scan, classify, prescribe, and verify package lifecycle states",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revenant-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "revenant",
    "dependencies",
    "npm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@revenant/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
